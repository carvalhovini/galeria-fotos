{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "galeria-admin",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-05",

  // Só acessível pelo domínio próprio, que fica atrás do Cloudflare Access.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "admin.carvalhovini.com", "custom_domain": true }],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // galeria-entrada é privado: só este Worker e o workflow de publicação acessam.
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "galeria-fotos" },
    { "binding": "INBOX", "bucket_name": "galeria-entrada" }
  ],

  // Secrets (wrangler secret put): CF_API_TOKEN, CF_ZONE_ID e GITHUB_TOKEN.
  "vars": {
    "PUBLIC_R2_BASE_URL": "https://fotos.carvalhovini.com",
    "ACCESS_TEAM_DOMAIN": "https://[SEU-TIME].cloudflareaccess.com",
    "ACCESS_AUD": "[AUD-DO-APP-NO-ACCESS]",
    "PURGE_ORIGINS": "https://carvalhovini.com,https://www.carvalhovini.com,https://galeria-fotos.carvalhovini2002.workers.dev",
    "GITHUB_REPO": "carvalhovini/galeria-fotos",
    "GITHUB_WORKFLOW": "publish.yml",
    "GITHUB_REF": "main"
  },

  "observability": { "enabled": true }
}
