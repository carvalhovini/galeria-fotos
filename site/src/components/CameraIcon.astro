---
interface Props {
  size: number;
  stroke: string;
  strokeWidth: number;
  class?: string;
}
const { size, stroke, strokeWidth, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 28 28"
  fill="none"
  stroke={stroke}
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <rect x="3" y="8" width="22" height="15" rx="3"></rect>
  <path d="M10 8l1.8-3h4.4L18 8"></path>
  <circle cx="14" cy="15.5" r="4.5"></circle>
</svg>
