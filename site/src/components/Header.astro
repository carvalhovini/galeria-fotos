---
import { SITE } from '../config';
import CameraIcon from './CameraIcon.astro';
import InstagramIcon from './InstagramIcon.astro';
---

<header class="site-header container">
  <a class="brand" href="/" aria-label={`${SITE.name}, início`}>
    <CameraIcon size={28} stroke="#FF6A2B" strokeWidth={2} />
    <span class="brand-name">{SITE.name}</span>
  </a>
  <a class="pill" href={SITE.instagram.url} target="_blank" rel="noopener">
    <InstagramIcon />
    Seguir no Instagram
  </a>
</header>
