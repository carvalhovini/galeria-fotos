---
interface Props {
  size: number;
  stroke: string;
  strokeWidth: number;
  class?: string;
}
const { size, stroke, strokeWidth, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 28 28"
  fill="none"
  stroke={stroke}
  stroke-width={strokeWidth}
  stroke-linecap="round"
  aria-hidden="true"
>
  <circle cx="14" cy="14" r="11"></circle>
